#!/bin/sh
# Runs the specs in test/ (or the ones given), each in its own Vim with the
# dotfiles' config loaded, then the live plugins' own test/run.vim against the
# same checkouts. Exits non-zero when anything fails, except the tests listed
# in test/known-failures.txt.
#
#   bin/test                      everything
#   bin/test test/fzf-utils.vim   one spec
#
# The checkouts are in $SUITE_DEPS (default deps/, made by bin/fetch).
root=$(cd "$(dirname "$0")/.." && pwd)
SUITE_DEPS=${SUITE_DEPS:-$root/deps}
PATH=$root/test/bin:$PATH
LC_ALL=C.UTF-8
THEMIS_HOME=$SUITE_DEPS/vim-themis
export SUITE_DEPS PATH LC_ALL THEMIS_HOME
known=$root/test/known-failures.txt
raw=$(mktemp)
report=$(mktemp)
vimout=$(mktemp)
# Vim's input: open, with nothing typed, as at a keyboard. At end of file
# instead (</dev/null, or CI), a plugin polling for a key, as fugitive's :Git
# does while git runs, makes the Ex-mode Vim quit mid-spec with status 0.
keys=$(mktemp -u)
mkfifo "$keys"
exec 4<>"$keys"
trap 'rm -f "$raw" "$report" "$vimout" "$keys"' EXIT

# A spec's Vim: Themis started by test/helper/startup.vim (see there why not
# by vim-themis' bin/themis). Its TAP report (Vim's stderr) goes to stdout.
# Vim's own output goes to a file, shown when the spec fails.
themis() {
  vim -u NONE -i NONE -n -N -e -s -c "source $root/test/helper/startup.vim" \
    -- --reporter tap "$@" <&4 2>&1 >"$vimout"
}

# Whether "<suite> <test>" is in test/known-failures.txt
listed() {
  grep -v '^[[:space:]]*\(#\|$\)' "$known" 2>/dev/null |
    awk -v t="$1" '$1 " " $2 == t { found = 1 } END { exit !found }'
}

# On GitHub Actions, a line also shown as an annotation on the pull request
note() {
  echo "$2"
  [ -n "${GITHUB_ACTIONS:-}" ] &&
    printf '::%s::%s\n' "$1" "$(printf '%s' "$2" | awk 'NR > 1 { printf "%%0A" } { printf "%s", $0 }')"
  return 0
}

failed=
knownfailed=
fixed=
if [ $# -eq 0 ]; then
  set -- "$root"/test/*.vim
  live=$(awk '$3 == "live" { print $1 }' "$root/plugins.txt")
fi
for spec do
  name=$(basename "$spec" .vim)
  echo "### $name"
  themis "$spec" >"$raw"
  status=$?
  # Vim's ex mode ends lines with \r\n
  tr -d '\r' <"$raw" >"$report"
  cat "$report"
  plan=$(sed -n 's/^1\.\.\([0-9]*\)$/\1/p' "$report" | head -n 1)
  ran=$(grep -c '^\(not \)\{0,1\}ok [0-9]' "$report")
  unlisted=$(sed -n 's/^not ok [0-9]* - //p' "$report" |
    while IFS= read -r t; do listed "$t" || echo "$t"; done)
  specknown=$(sed -n 's/^not ok [0-9]* - //p' "$report" |
    while IFS= read -r t; do listed "$t" && printf '\n  %s' "$t"; done)
  knownfailed="$knownfailed$specknown"
  fixed="$fixed$(sed -n 's/^ok [0-9]* - //p' "$report" |
    while IFS= read -r t; do listed "$t" && printf '\n  %s' "$t"; done)"
  # Failed outside the list, or stopped before running all its tests (which
  # Vim can do with exit status 0)
  if [ -n "$unlisted" ] || [ "$ran" != "${plan:-x}" ] ||
    { [ "$status" -ne 0 ] && [ -z "$specknown" ]; }; then
    failed="$failed $name"
    if grep -q '[^[:space:]]' "$vimout"; then
      echo "# Vim's output:"
      tr -d '\r' <"$vimout" | sed 's/^/#   /'
    fi
  fi
done
for name in ${live:-}; do
  echo "### $name (its own test/run.vim)"
  (cd "$SUITE_DEPS/$name" && PLUGINS=$SUITE_DEPS vim -Nu NONE -i NONE -Es -S test/run.vim) || failed="$failed $name"
done

echo
[ -n "$knownfailed" ] && note notice "known failures (test/known-failures.txt), not counted:$knownfailed"
[ -n "$fixed" ] && note warning "listed in test/known-failures.txt but passed here; remove them if the bug is fixed:$fixed"
[ -z "$failed" ] && echo "all passed" && exit 0
echo "failed:$failed"
exit 1
