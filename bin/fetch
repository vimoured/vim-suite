#!/bin/sh
# Checks out every repository in plugins.txt into $SUITE_DEPS (default deps/):
# a shallow clone of its default branch, or, when already there, an update to
# that branch's latest commit. All the repositories are public; no token.
# Then makes $SUITE_DEPS/python, a venv with test/requirements.txt, from
# $SUITE_PYTHON (default python3; the suite is checked with 3.14), and
# test/requirements-pytest.txt unless SUITE_PYTEST=0 (CI installs it only for
# Python-related pull requests).
#
#   bin/fetch
set -e
root=$(cd "$(dirname "$0")/.." && pwd)
SUITE_DEPS=${SUITE_DEPS:-$root/deps}
mkdir -p "$SUITE_DEPS"

grep -v '^[[:space:]]*\(#\|$\)' "$root/plugins.txt" | while read -r name repo role; do
  dir=$SUITE_DEPS/$name
  url=https://github.com/$repo.git
  if [ -d "$dir/.git" ]; then
    echo "update $name"
    git -C "$dir" fetch --quiet --depth 1 origin HEAD
    git -C "$dir" reset --quiet --hard FETCH_HEAD
  else
    echo "clone  $name"
    git clone --quiet --depth 1 "$url" "$dir"
  fi
done

venv=$SUITE_DEPS/python
if [ ! -x "$venv/bin/python" ]; then
  echo "venv   python ($("${SUITE_PYTHON:-python3}" --version))"
  "${SUITE_PYTHON:-python3}" -m venv "$venv"
else
  echo "update python"
fi
"$venv/bin/python" -m pip install --quiet --disable-pip-version-check -r "$root/test/requirements.txt"
if [ "${SUITE_PYTEST:-1}" != 0 ]; then
  "$venv/bin/python" -m pip install --quiet --disable-pip-version-check -r "$root/test/requirements-pytest.txt"
fi
